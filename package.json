{
  "name": "irg",
  "version": "0.1.0",
  "description": "IRG - Intelligent Robot Guide. A lightweight AI programming assistant.",
  "type": "module",
  "bin": {
    "irg": "./bin/irg.js"
  },
  "files": [
    "bin",
    "skills",
    "app/main.js",
    "app/main.js.map",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "main": "gui/dist/main/index.mjs",
  "scripts": {
    "build": "esbuild ./app/main.ts --bundle --platform=node --format=esm --outfile=./bin/irg.js --external:playwright --external:chromium-bidi --external:readline/promises && cp -r ./skills ./bin/ 2>/dev/null || true",
    "build:exe": "mkdir -p ./dist && bun build --compile --outfile ./dist/irg ./app/main.ts",
    "dev": "bun ./app/main.ts",
    "dev:gui": "cd gui && npm run dev",
    "build:gui": "cd gui && npm run build",
    "build:electron-main": "mkdir -p gui/dist/main && esbuild gui/main/index.ts --bundle --platform=node --format=esm --outfile=gui/dist/main/index.mjs --external:electron --external:playwright --external:chromium-bidi && esbuild gui/main/preload.ts --bundle --platform=node --format=cjs --outfile=gui/dist/main/preload.cjs --external:electron",
    "build:electron": "npm run build:gui && npm run build:electron-main",
    "dev:electron": "npm run build:electron-main && electron . --no-sandbox",
    "dev:electron:gui": "npm run build:electron-main && concurrently \"npm run dev:gui\" \"wait-on http://localhost:3001 && electron . --no-sandbox\"",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:gui": "tsc -p gui/tsconfig.renderer.json --noEmit",
    "check": "bun run build && node ./bin/irg.js --help",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent",
    "cli",
    "llm",
    "tools",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.144",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "c8": "^11.0.0",
    "electron": "^41.2.0",
    "is-dark": "^1.0.4",
    "js-yaml": "^4.1.1",
    "opencode-ai": "^1.14.40",
    "picocolors": "^1.1.1",
    "pixi.js": "^8.18.1",
    "playwright": "^1.59.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xstate": "^5.31.0",
    "zustand": "^5.0.13"
  }
}
