# IRG Docker Environment Configuration
# Copy this file to .env and fill in your values

# =====================
# LLM Configuration
# =====================
IRG_LLM_PROVIDER=openai
IRG_LLM_API_KEY=your-api-key-here
IRG_LLM_MODEL=gpt-4o-mini
IRG_LLM_BASE_URL=https://api.openai.com/v1
# IRG_LLM_SYSTEM_PROMPT=Custom system prompt (optional)

# =====================
# Context Window Settings
# =====================
# Adjust based on your model's capabilities
IRG_CONTEXT_WINDOW=200000
IRG_MAX_OUTPUT_TOKENS=4096

# =====================
# Docker Paths
# =====================
# Working directory to mount (default: current directory)
IRG_WORKSPACE=.
# Directory containing .proto files for gRPC
IRG_PROTO_DIR=./protos

# =====================
# HTTP API
# =====================
IRG_HTTP_PORT=3002
